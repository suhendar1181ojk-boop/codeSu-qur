# Apache — cPanel, shared hosting, and a Laravel project's public/ folder.
Options -Indexes
AddType application/manifest+json .webmanifest
AddType text/javascript .js

<IfModule mod_rewrite.c>
  RewriteEngine On
  # A PWA installs only over https. (localhost is left alone for testing.)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Google Play's proof of ownership, kept in well-known/ (no dot). Only these
  # files: the host's own /.well-known/acme-challenge (SSL renewal) is untouched.
  RewriteRule ^\.well-known/(assetlinks\.json|apple-app-site-association)$ well-known/$1 [L]
</IfModule>

<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
