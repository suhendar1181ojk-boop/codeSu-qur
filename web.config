<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (Windows hosting, Plesk on Windows): the manifest's type, which IIS does not know. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
  </system.webServer>
</configuration>
